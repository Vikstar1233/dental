# The only configuration the app needs. Everything else -- Meta, Aircall,
# Dentally, email -- is entered in the portal's Integrations page and stored
# encrypted in the database (Supabase Vault), never in code or env files.

# From Supabase: Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=

# Base URL this app is reachable at (used for reset-password and Meta
# redirect links). Must be the public https:// URL once deployed.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
